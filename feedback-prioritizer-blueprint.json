            "version": 1,
            "parameters": {},
            "mapper": {
                "scope": "roundtrip",
                "variables": [
                    {
                        "name": "feedback_item",
                        "value": "{\n  \"items\": [\n    {\n      \"source\": \"App Store review\",\n      \"text\": \"I love the product but I genuinely can't figure out the pricing tiers. Spent 20 minutes on the pricing page still confused which plan I need.\"\n    },\n    {\n      \"source\": \"Support ticket\",\n      \"text\": \"Why is there no CSV export? I need this data in Excel for my manager every week and I'm stuck copy-pasting rows manually.\"\n    },\n    {\n      \"source\": \"Survey response\",\n      \"text\": \"The dashboard takes forever to load, especially in the mornings. Sometimes I just give up and check back later.\"\n    },\n    {\n      \"source\": \"App Store review\",\n      \"text\": \"First week was rough — nobody explained what to do after signup. Just dropped into an empty dashboard with no guidance.\"\n    },\n    {\n      \"source\": \"Support ticket\",\n      \"text\": \"Your support team resolved my billing issue in literally 10 minutes over chat. Genuinely impressed, wanted to say thanks.\"\n    },\n    {\n      \"source\": \"Survey response\",\n      \"text\": \"Confusing pricing page. I upgraded thinking I'd get feature X and didn't — had to email support to understand the difference between plans.\"\n    },\n    {\n      \"source\": \"App Store review\",\n      \"text\": \"Mobile app crashes every time I try to attach a photo to a report. Happens on both wifi and mobile data.\"\n    },\n    {\n      \"source\": \"Support ticket\",\n      \"text\": \"Please add export to Excel or Google Sheets. Being locked into your UI for reporting is a dealbreaker for my team.\"\n    },\n    {\n      \"source\": \"Survey response\",\n      \"text\": \"Loading is painfully slow when I have more than a few hundred rows. Feels like it's not built for real data volume.\"\n    },\n    {\n      \"source\": \"App Store review\",\n      \"text\": \"Onboarding just throws you in with zero tooltips. A short walkthrough would've saved me an hour of clicking around confused.\"\n    },\n    {\n      \"source\": \"Support ticket\",\n      \"text\": \"Whoever handled my refund request was fantastic — fast, clear, no hassle at all.\"\n    },\n    {\n      \"source\": \"Survey response\",\n      \"text\": \"I still don't understand what's different between the Pro and Business plans. The comparison table doesn't help much.\"\n    },\n    {\n      \"source\": \"App Store review\",\n      \"text\": \"Export feature would change everything for me. Right now I screenshot tables which is embarrassing honestly.\"\n    },\n    {\n      \"source\": \"Support ticket\",\n      \"text\": \"App froze and crashed twice today on Android while uploading images.\"\n    },\n    {\n      \"source\": \"Survey response\",\n      \"text\": \"Dashboard load time got noticeably worse over the last month. Used to be fast, now it's a coffee-break wait.\"\n    },\n    {\n      \"source\": \"App Store review\",\n      \"text\": \"New user here — wish there was a guided setup instead of a blank screen. Almost gave up on day one.\"\n    },\n    {\n      \"source\": \"Support ticket\",\n      \"text\": \"Billing was unclear so I contacted support, and honestly the rep was excellent and patient with me.\"\n    },\n    {\n      \"source\": \"Survey response\",\n      \"text\": \"Would pay more for a real export function. CSV, Excel, anything — just get my data out of here easily.\"\n    },\n    {\n      \"source\": \"App Store review\",\n      \"text\": \"Crashes when attaching files on mobile, very frustrating during client visits.\"\n    },\n    {\n      \"source\": \"Support ticket\",\n      \"text\": \"Pricing page doesn't clarify what happens if I go over my usage limit. Found out the hard way with a surprise charge.\"\n    },\n    {\n      \"source\": \"Survey response\",\n      \"text\": \"Big pages load slowly, especially on my laptop which isn't old. Might be a backend issue on your end.\"\n    },\n    {\n      \"source\": \"App Store review\",\n      \"text\": \"No onboarding checklist or tour at all. Felt lost for the first few days using this.\"\n    },\n    {\n      \"source\": \"Support ticket\",\n      \"text\": \"Just wanted to flag — your live chat support has been consistently great every time I've used it.\"\n    },\n    {\n      \"source\": \"Survey response\",\n      \"text\": \"I need to export reports weekly and currently rely on a third-party workaround because you don't support it natively.\"\n    }\n  ]\n}"
                    }
                ]
            },
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
                },
                "restore": {
                    "expect": {
                        "scope": {
                            "label": "One cycle"
